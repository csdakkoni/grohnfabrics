```
src/
├── app/
│   ├── (store)/          # Mağaza sayfaları (müşteri)
│   │   ├── products/     # Ürün listesi ve detay
│   │   ├── checkout/     # Ödeme sayfası
│   │   ├── account/      # Kullanıcı hesabı
│   │   └── order/        # Sipariş takibi
│   ├── (admin)/          # Admin paneli
│   │   └── admin/
│   │       ├── products/ # Ürün yönetimi
│   │       ├── orders/   # Sipariş yönetimi
│   │       ├── stock/    # Stok (rulo bazlı)
│   │       └── settings/ # Ayarlar
│   ├── api/              # API routes
│   │   ├── checkout/     # Ödeme başlatma
│   │   ├── payment/      # Webhook'lar (iyzico + Stripe)
│   │   └── shipping/     # UPS entegrasyonu
│   └── login/            # Giriş sayfası
├── components/
│   ├── store/            # Mağaza bileşenleri
│   └── admin/            # Admin bileşenleri
├── lib/
│   ├── supabase/         # Supabase client (admin + client)
│   ├── ups/              # UPS API servisi
│   ├── email/            # E-posta şablonları
│   ├── i18n/             # Çoklu dil desteği
│   ├── cart.ts           # Sepet yönetimi
│   └── r2.ts             # Cloudflare R2
